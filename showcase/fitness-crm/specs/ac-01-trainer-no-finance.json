{
  "storyAc": "AC-01",
  "spec": {
    "steps": [
      {
        "id": "open-login",
        "type": "navigate",
        "path": "/login"
      },
      {
        "id": "email",
        "type": "fill",
        "target": {
          "by": "label",
          "label": "Email",
          "within": {
            "by": "role",
            "role": "main"
          }
        },
        "value": "demo-trainer@fitness-crm.test"
      },
      {
        "id": "password",
        "type": "fill",
        "target": {
          "by": "label",
          "label": "Password",
          "within": {
            "by": "role",
            "role": "main"
          }
        },
        "value": {
          "secret": "GYM_PASSWORD"
        }
      },
      {
        "id": "sign-in",
        "type": "click",
        "target": {
          "by": "role",
          "role": "button",
          "name": "Sign in",
          "within": {
            "by": "role",
            "role": "main"
          }
        }
      },
      {
        "id": "signed-in",
        "type": "expectUrl",
        "path": "/dashboard"
      },
      {
        "id": "no-finance-menu",
        "type": "expectHidden",
        "target": {
          "by": "role",
          "role": "link",
          "name": "Tài chính",
          "exact": true
        },
        "sourceRefs": ["GYM-AC@v1"]
      },
      {
        "id": "open-finance-directly",
        "type": "navigate",
        "path": "/finance"
      },
      {
        "id": "finance-refused",
        "type": "expectText",
        "target": {
          "by": "role",
          "role": "main"
        },
        "text": "Bạn không có quyền xem trang này",
        "sourceRefs": ["GYM-AC@v1"]
      }
    ]
  }
}
