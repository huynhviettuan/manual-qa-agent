{
  "storyAc": "AC-04",
  "spec": {
    "steps": [
      {
        "id": "open-login",
        "type": "navigate",
        "path": "/login"
      },
      {
        "id": "email",
        "type": "fill",
        "target": {
          "by": "label",
          "label": "Email",
          "within": {
            "by": "role",
            "role": "main"
          }
        },
        "value": "demo-manager@fitness-crm.test"
      },
      {
        "id": "password",
        "type": "fill",
        "target": {
          "by": "label",
          "label": "Password",
          "within": {
            "by": "role",
            "role": "main"
          }
        },
        "value": {
          "secret": "GYM_PASSWORD"
        }
      },
      {
        "id": "sign-in",
        "type": "click",
        "target": {
          "by": "role",
          "role": "button",
          "name": "Sign in",
          "within": {
            "by": "role",
            "role": "main"
          }
        }
      },
      {
        "id": "signed-in",
        "type": "expectUrl",
        "path": "/dashboard"
      },
      {
        "id": "open-leads",
        "type": "navigate",
        "path": "/leads"
      },
      {
        "id": "add-lead",
        "type": "click",
        "target": {
          "by": "role",
          "role": "button",
          "name": "Thêm lead",
          "within": {
            "by": "role",
            "role": "main"
          }
        }
      },
      {
        "id": "name",
        "type": "fill",
        "target": {
          "by": "label",
          "label": "Họ và tên",
          "within": {
            "by": "role",
            "role": "dialog",
            "name": "Thêm lead"
          }
        },
        "value": "QA Showcase AC-04"
      },
      {
        "id": "open-channel",
        "type": "click",
        "target": {
          "by": "label",
          "label": "Kênh liên hệ",
          "within": {
            "by": "role",
            "role": "dialog",
            "name": "Thêm lead"
          }
        }
      },
      {
        "id": "channel",
        "type": "click",
        "target": {
          "by": "role",
          "role": "option",
          "name": "Khác",
          "exact": true,
          "within": {
            "by": "role",
            "role": "listbox"
          }
        }
      },
      {
        "id": "save",
        "type": "click",
        "target": {
          "by": "role",
          "role": "button",
          "name": "Lưu",
          "exact": true,
          "within": {
            "by": "role",
            "role": "dialog",
            "name": "Thêm lead"
          }
        }
      },
      {
        "id": "note-required",
        "type": "expectText",
        "target": {
          "by": "role",
          "role": "dialog",
          "name": "Thêm lead"
        },
        "text": "Đã chọn \"Khác\" thì phải ghi rõ",
        "sourceRefs": ["GYM-AC@v1"]
      },
      {
        "id": "still-open",
        "type": "expectVisible",
        "target": {
          "by": "role",
          "role": "dialog",
          "name": "Thêm lead"
        },
        "sourceRefs": ["GYM-AC@v1"]
      }
    ]
  }
}
