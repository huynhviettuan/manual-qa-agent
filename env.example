# Names only. Inject real values from a secret manager; never commit them.

# PostgreSQL connection string. If unset, the CLI/API use an embedded PGlite database in ./.pglite (dev only).
DATABASE_URL=

# Draft provider, also the default readiness provider: anthropic (default) | openai. See docs/adr/0006.
QA_LLM_PROVIDER=

# Optional: route readiness to a typed-decision API instead: openai (Decisions API) | jev (TypeSafe).
# See docs/adr/0007. Drafts still come from QA_LLM_PROVIDER.
QA_READINESS_PROVIDER=

# Drafts model. Anthropic: default claude-opus-5-5 (also used for readiness when Claude answers it).
# OpenAI: Responses API model, REQUIRED when live (no default is assumed).
QA_LLM_MODEL=

# Decision-API model for readiness: OpenAI default gpt-6-luna; Jev default jev-1.13.0 (pinned).
QA_DECISIONS_MODEL=

# Optional readiness-confidence floor in (0, 1]. Only applies to providers that report
# confidence (OpenAI Decisions) and can only route to human review. Leave unset until calibrated.
QA_MIN_READY_CONFIDENCE=

# Set to 1 to call the real provider API (billed). Default: heuristic behind the real SDK, no network.
QA_LIVE_LLM=

# Credentials for the selected provider; only needed when QA_LIVE_LLM=1.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TYPESAFE_API_KEY=

# HTTP port for the API (default 3000).
PORT=

# ---- Phase 2: execution (docs/adr/0008) ----

# Evidence store root (screenshots, step and network logs). Default .evidence (git-ignored).
QA_EVIDENCE_DIR=

# Secrets referenced by executable specs as { "secret": "NAME" } resolve from QA_SECRET_<NAME>.
# Example for the demo app (and `pnpm demo:sut`):
QA_SECRET_DEMO_PASSWORD=

# Use an installed browser instead of Playwright's bundled chromium: chrome | msedge.
QA_BROWSER_CHANNEL=

# Kill switch: set to 0 to disable all test execution (docs/09 incident response).
QA_EXECUTION_ENABLED=

# Development only: run the worker inside the API process (needed with embedded PGlite,
# which is single-process). Production runs `pnpm worker` against PostgreSQL.
QA_EMBEDDED_WORKER=

# Worker: drain the queue and exit (cron/CI); idle polling interval in ms.
QA_WORKER_ONCE=
QA_WORKER_IDLE_MS=

# Demo app port for `pnpm demo:sut` (default 4000); DEMO_BUG_1042=1 reintroduces BUG-1042.
DEMO_PORT=
DEMO_BUG_1042=
